<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Маскот на столе», 4×4 — комната: сцена сверху, три плитки снизу.

  Набор `@+id` во всех четырёх разметках маскота ОДИН: провайдер общий, и
  действие RemoteViews на отсутствующий id падает уже на устройстве. Лишнее
  для этого размера лежит скрытым в конце файла.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tg_shape_32"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="59">

            <ImageView
                android:id="@+id/tile_streak"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/tg_shape_24"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/floor"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_gravity="bottom"
                android:src="@drawable/tg_shape_24"
                android:contentDescription="@null" />

            <!--
              Персонаж стоит НА кромке пола и не залезает на него: во время
              прокрутки кадр рисуется на непрозрачной подложке цвета плитки
              (так битмап вдвое легче и проходит в Binder), и полоса пола под
              ним оказалась бы перекрыта прямоугольником.
            -->
            <ImageView
                android:id="@+id/mascot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="44dp"
                android:scaleType="center"
                android:contentDescription="@null" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left|top"
                android:layout_margin="12dp">

                <ImageView
                    android:id="@+id/stage_chip"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tg_shape_100"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:fontFamily="@font/onest_extrabold"
                    android:includeFontPadding="false"
                    android:text="" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right|top"
                android:layout_margin="12dp">

                <ImageView
                    android:id="@+id/sleep_chip"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tg_shape_100"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/sleep_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="11dp"
                    android:textStyle="bold"
                    android:fontFamily="@font/onest_bold"
                    android:includeFontPadding="false"
                    android:text="" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="26"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/tile_progress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tg_shape_18"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp">

                    <TextView
                        android:id="@+id/streak_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24dp"
                        android:textStyle="bold"
                        android:fontFamily="@font/onest_extrabold"
                        android:includeFontPadding="false"
                        android:text="0" />

                    <TextView
                        android:id="@+id/streak_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="10dp"
                        android:fontFamily="@font/onest_bold"
                        android:includeFontPadding="false"
                        android:text="" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="8dp">

                <ImageView
                    android:id="@+id/tile_record"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tg_shape_18"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp">

                    <ImageView
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:scaleType="fitXY"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/next_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textSize="10dp"
                        android:fontFamily="@font/onest_bold"
                        android:includeFontPadding="false"
                        android:text="" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="8dp">

                <ImageView
                    android:id="@+id/stage"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/sub"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp">

                    <TextView
                        android:id="@+id/record_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="24dp"
                        android:textStyle="bold"
                        android:fontFamily="@font/onest_extrabold"
                        android:includeFontPadding="false"
                        android:text="0" />

                    <TextView
                        android:id="@+id/record_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="10dp"
                        android:fontFamily="@font/onest_bold"
                        android:includeFontPadding="false"
                        android:text="" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/empty_label"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:textSize="14dp"
        android:textStyle="bold"
        android:fontFamily="@font/onest_extrabold"
        android:includeFontPadding="false"
        android:visibility="gone"
        android:text="" />

</FrameLayout>
