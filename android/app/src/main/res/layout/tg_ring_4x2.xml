<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Кольцо года», 4×2.

  Слева круговой прогресс до следующей годовщины с числом дней в центре,
  справа колонка: год вместе, сколько осталось, дата и две плитки со
  счётчиками.

  Кольцо приходит картинкой (`WidgetImages.ring`): дуги RemoteViews не рисует,
  а `ProgressBar` со стилем circular не принимает цвет темы. Число лежит
  поверх картинки во `FrameLayout` — так оно всегда в центре кольца, каким бы
  ни была ячейка.

  Все заливки — ImageView с нейтральной белой фигурой, цвет ставит код по
  активной теме приложения.

  Кегли на нижней границе вилки лончеров компактные; на высокой ячейке их
  растягивает `WidgetSizing.scale` из кода.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tg_shape_32"
        android:contentDescription="@null" />

    <!-- Пустое состояние: партнёр не подключён или дата начала не задана. -->
    <TextView
        android:id="@+id/empty_label"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:textSize="13dp"
        android:fontFamily="@font/onest_extrabold"
        android:includeFontPadding="false"
        android:visibility="gone"
        android:text="@string/tg_widget_no_start_date" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp">

            <ImageView
                android:id="@+id/ring"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/ring_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22dp"
                    android:fontFamily="@font/onest_extrabold"
                    android:letterSpacing="-0.04"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—" />

                <TextView
                    android:id="@+id/ring_days_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="9dp"
                    android:fontFamily="@font/onest_extrabold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="дней" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="15dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/year_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="9dp"
                android:fontFamily="@font/onest_extrabold"
                android:letterSpacing="0.03"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=" " />

            <TextView
                android:id="@+id/left_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="15dp"
                android:fontFamily="@font/onest_extrabold"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=" " />

            <TextView
                android:id="@+id/next_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="9dp"
                android:fontFamily="@font/onest_extrabold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text=" " />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/tile_left_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/tg_shape_16"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="7dp"
                        android:paddingRight="7dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/tile_left_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="8dp"
                            android:fontFamily="@font/onest_extrabold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="МЕСЯЦЕВ" />

                        <TextView
                            android:id="@+id/tile_left_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textSize="14dp"
                            android:fontFamily="@font/onest_extrabold"
                            android:letterSpacing="-0.025"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="—" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp">

                    <ImageView
                        android:id="@+id/tile_right_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/tg_shape_16"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingLeft="7dp"
                        android:paddingRight="7dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/tile_right_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="8dp"
                            android:fontFamily="@font/onest_extrabold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="ВОСПОМИНАНИЙ" />

                        <TextView
                            android:id="@+id/tile_right_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:textSize="14dp"
                            android:fontFamily="@font/onest_extrabold"
                            android:letterSpacing="-0.025"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="—" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
