<?xml version="1.0" encoding="utf-8"?>
<!--
  «Чем заняты», 4x2. Вся картинка рисуется на холсте в DoingWidgetProvider и
  кладётся в одну ImageView. Нажатие в любом месте открывает выбор своего
  занятия (обработчик висит на widget_root).

  Только классы из белого списка RemoteViews: FrameLayout, LinearLayout,
  ImageView. Голый View здесь нельзя — виджет не инфлейтится вовсе.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/doing_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/tg_desc_doing_4x2" />
</FrameLayout>
