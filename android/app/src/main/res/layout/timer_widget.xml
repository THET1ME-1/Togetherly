<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_rounded"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp">

    <!-- Заголовок: эмодзи + название таймера -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/timer_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/timer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Таймер"
            android:textSize="11sp"
            android:textColor="#666666"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Крупное число дней -->
    <TextView
        android:id="@+id/timer_days_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="38sp"
        android:textStyle="bold"
        android:textColor="#8B5CF6"
        android:layout_marginTop="4dp"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/timer_days_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="дней"
        android:textSize="13sp"
        android:textColor="#888888" />

    <TextView
        android:id="@+id/timer_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="9sp"
        android:textColor="#AAAAAA"
        android:layout_marginTop="4dp" />

</LinearLayout>
