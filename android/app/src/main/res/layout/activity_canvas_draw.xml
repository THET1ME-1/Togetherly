<?xml version="1.0" encoding="utf-8"?>
<!--
  Окно рисования поверх рабочего стола.

  Выглядит как сам виджет: тот же холст, те же скругления. Рисовать внутри
  виджета Android не даёт, поэтому поверх стола открывается прозрачное окно —
  тот же приём, что у «Заметки на двоих».
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="18dp">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/tg_shape_32"
        android:clipToOutline="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="320dp">

            <ImageView
                android:id="@+id/sheet_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <com.togetherly.love.DrawSheet
                android:id="@+id/sheet_draw"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/colors"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/undo"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:textSize="15dp"
                android:textStyle="bold"
                android:fontFamily="@font/onest_bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/done"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="15dp"
                android:textStyle="bold"
                android:fontFamily="@font/onest_extrabold"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
