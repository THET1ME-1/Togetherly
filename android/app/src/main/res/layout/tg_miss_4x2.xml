<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Скучаю», 4×2 — «Двое и кнопка».

  Две плитки одинаковой ширины (layout_weight="1" у обеих, поэтому своя не
  шире партнёрской), под ними одна кнопка во всю ширину. Имя партнёра стоит
  рядом с аватаркой в широкой строке: в узкой колонке над числом оно
  обрезалось на «JB SHAR…».

  Кегль числа приходит из кода: «1000» при жёстких 28dp разрывалось на две
  строки — «100» и «0» под ним (снимок 20.09.2026). Правило —
  `missCountSize` в lib/models/miss_widget_spec.dart.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tg_shape_32"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Моя плитка -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/my_tile_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tg_shape_18"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="22dp"
                            android:layout_height="22dp">

                            <ImageView
                                android:id="@+id/my_avatar_bg"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/tg_shape_circle"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/my_avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textSize="10dp"
                                android:textStyle="bold"
                                android:includeFontPadding="false"
                                android:text="?" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/my_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="7dp"
                            android:textSize="11.5dp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/my_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="30dp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="0" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="10dp"
                android:layout_height="match_parent" />

            <!-- Плитка партнёра -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/partner_tile_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tg_shape_18"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="22dp"
                            android:layout_height="22dp">

                            <ImageView
                                android:id="@+id/avatar_bg"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/tg_shape_circle"
                                android:contentDescription="@null" />

                            <ImageView
                                android:id="@+id/avatar_photo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:textSize="10dp"
                                android:textStyle="bold"
                                android:includeFontPadding="false"
                                android:text="?" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/partner_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginLeft="7dp"
                            android:textSize="11.5dp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/partner_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="30dp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="0" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Когда отправляли в последний раз -->
        <TextView
            android:id="@+id/last_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="11dp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <!-- Кнопка во всю ширину: действие тут одно и оно главное -->
        <FrameLayout
            android:id="@+id/send_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/send_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/tg_shape_22"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/state_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_tg_heart"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/send_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
