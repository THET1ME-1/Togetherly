<?xml version="1.0" encoding="utf-8"?>
<!--
  «Скучаю» 4×2. Фон surface #FEF7FF, радиус 32, отступы 20/22. Сверху заголовок
  14/800 и время последней отправки 12/600 #7A757F. Снизу две плашки со
  счётчиками (моя #EADDFF, партнёра #FFD8E4, число 34/800) и кнопка 64×64
  радиус 22 #6750A4 — она и отправляет.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/tg_bg_surface_32"
    android:paddingLeft="22dp"
    android:paddingRight="22dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#1D1B20"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:includeFontPadding="false"
            android:text="СКУЧАЮ СЕГОДНЯ" />

        <TextView
            android:id="@+id/last_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#7A757F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:text="" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/tg_tile_primary_24"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4F378B"
                android:textSize="12sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:text="Я" />

            <TextView
                android:id="@+id/my_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#21005D"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false"
                android:text="0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            android:background="@drawable/tg_tile_tertiary_24"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/partner_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#7D5260"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="Партнёр" />

            <TextView
                android:id="@+id/partner_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#31111D"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false"
                android:text="0" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/send_button"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/tg_btn_primary_22">

            <ImageView
                android:id="@+id/state_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tg_heart"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
