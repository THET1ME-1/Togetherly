<?xml version="1.0" encoding="utf-8"?>
<!--
  Вариант виджета «Дни вместе» со своими фотографиями пары.

  Отдельный файл, а не переключение видимости внутри общего: у RemoteViews нет
  способа подвинуть блок с числом и датой, а рисунок пары и два круглых снимка
  занимают разную высоту. В общем макете колонка стоит по центру, и на виджете
  2×2 дата ложилась прямо на аватары — тёмная строка на снимке не читалась
  («когда выбираешь показывать свои фото — дату не видно», @qwinken,
  25.08.2026). Здесь колонка прижата к верху, снимки мельче, а под датой —
  светлая пилюля на случай самой тесной ячейки.

  Все id общего макета сохранены: провайдер шлёт одни и те же команды, а
  RemoteViews падает на действии с неизвестным id.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_pink_border"
    android:clipToOutline="true"
    android:padding="0dp">

    <!-- Рисунок пары в этом варианте не нужен: его место занимают снимки.
         Поле оставлено ради общих команд провайдера. -->
    <ImageView
        android:id="@+id/couple_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Снимки пары: два круга внизу, мельче обычного — над ними должна
         помещаться дата. -->
    <LinearLayout
        android:id="@+id/avatar_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/avatar_left"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/avatar_right"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="-8dp"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <TextView
        android:id="@+id/years_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:text="0 years already ❤️"
        android:textColor="#5D4037"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="26dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/days_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="#5D4037"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/days_label_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-1dp"
            android:text="Days"
            android:textColor="#5D4037"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/start_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_days_date_pill"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="23/07/2023"
            android:textColor="#5D4037"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Скрытые поля общего макета: провайдер пишет в них пустые строки. -->
    <TextView android:id="@+id/love_emoji" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/days_label" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/couple_names" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</RelativeLayout>
