<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Вместе», 4×2.

  Фон — не background у контейнера, а ImageView с нейтральной фигурой под ним:
  его перекрашивает код по активной теме приложения. У RemoteViews нет способа
  поменять цвет обычного background-drawable, а тем в приложении двадцать.

  Полоса прогресса тоже картинка: `progressDrawable` из кода не перекрасить.

  Ячейка 4×2 у каждого лончера своя — гайдлайны Android дают вилку 115…276dp
  по высоте. Nova выдаёт нижнюю границу (низ срезался), лончер Xiaomi — почти
  верхнюю (посреди карточки зияла дыра). Поэтому содержимое собрано в
  компактный блок и центрировано: лишняя высота уходит в поля.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tg_shape_32"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="1dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/start_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11dp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextView
                        android:id="@+id/days_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="36dp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="—" />

                    <TextView
                        android:id="@+id/days_word"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="3dp"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:text="дней" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/heart_icon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_heart_timer"
                android:contentDescription="@null" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/next_label"
                android:layout_width="1dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11dp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <TextView
                android:id="@+id/next_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="11dp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:text="" />
        </LinearLayout>

        <ImageView
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="5dp"
            android:scaleType="fitXY"
            android:contentDescription="@null" />
    </LinearLayout>
</FrameLayout>
