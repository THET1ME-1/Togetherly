<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Вместе», 4×2. Фон primary-container #EADDFF, радиус 32.

  Ячейка 4×2 у каждого лончера своя: Nova даёт низкую (низ срезался, полосы
  прогресса не было видно), стандартный лончер Xiaomi — вдвое выше макета
  (распорка на весе раздувалась в дыру посреди карточки). Поэтому содержимое
  собрано в компактный блок и центрировано по вертикали: лишняя высота уходит
  в равные поля сверху и снизу, а не в пустоту между строками.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/tg_bg_primary_container_32"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/start_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#4F378B"
                android:textSize="11dp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/days_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#21005D"
                    android:textSize="36dp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.04"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="3dp"
                    android:textColor="#21005D"
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text="дней" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/heart_icon"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:src="@drawable/ic_heart_timer"
            android:contentDescription="@null" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/next_label"
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#4F378B"
            android:textSize="11dp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <TextView
            android:id="@+id/next_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#4F378B"
            android:textSize="11dp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:text="" />
    </LinearLayout>

    <!-- Трек: RemoteViews умеет менять только progress, поэтому ProgressBar со
         своим drawable (подложка #D6C6F0, заливка #6750A4, скругление 100). -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="5dp"
        android:max="100"
        android:progress="56"
        android:progressDrawable="@drawable/tg_progress_12" />
</LinearLayout>
