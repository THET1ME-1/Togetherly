<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Вместе», размер 4×2. Фон primary-container #EADDFF, радиус 32,
  отступы 20/22. Слева дата старта 13/700 #4F378B, число 60/800 и «дней»
  17/700 по базовой линии, справа сердце 26dp. Внизу подпись до круглой даты
  и трек 12dp: #D6C6F0 с заливкой #6750A4.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/tg_bg_primary_container_32"
    android:paddingLeft="22dp"
    android:paddingRight="22dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/start_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4F378B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:text="С 1 ноября 2025" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:baselineAligned="true">

                <TextView
                    android:id="@+id/days_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#21005D"
                    android:textSize="60sp"
                    android:textStyle="bold"
                    android:letterSpacing="-0.04"
                    android:includeFontPadding="false"
                    android:text="205" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="6dp"
                    android:textColor="#21005D"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text="дней" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/heart_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_heart_timer"
            android:contentDescription="@null" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/next_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#4F378B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:text="До года — 160 дней" />

        <TextView
            android:id="@+id/next_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4F378B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:text="56%" />
    </LinearLayout>

    <!-- Трек: RemoteViews умеет менять только progress, поэтому ProgressBar со
         своим drawable (подложка #D6C6F0, заливка #6750A4, скругление 100). -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="56"
        android:progressDrawable="@drawable/tg_progress_12" />
</LinearLayout>
