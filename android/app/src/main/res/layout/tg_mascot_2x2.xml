<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Маскот на столе», 2×2 — полка: имя, ступень и полоса роста.

  Набор `@+id` во всех четырёх разметках маскота ОДИН: провайдер общий, и
  действие RemoteViews на отсутствующий id падает уже на устройстве. Лишнее
  для этого размера лежит скрытым в конце файла.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tg_shape_32"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="13dp"
                android:textStyle="bold"
                android:fontFamily="@font/onest_extrabold"
                android:includeFontPadding="false"
                android:text="" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/stage_chip"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tg_shape_100"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/stage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:maxLines="1"
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:fontFamily="@font/onest_bold"
                    android:includeFontPadding="false"
                    android:text="" />
            </FrameLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/mascot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:scaleType="center"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="10dp"
            android:fontFamily="@font/onest_bold"
            android:includeFontPadding="false"
            android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty_label"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textSize="12dp"
        android:textStyle="bold"
        android:fontFamily="@font/onest_extrabold"
        android:includeFontPadding="false"
        android:visibility="gone"
        android:text="" />

    <ImageView
        android:id="@+id/floor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="@null" />
    <TextView
        android:id="@+id/sub"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/streak_value"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/streak_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/sleep_chip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="@null" />
    <TextView
        android:id="@+id/sleep_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/record_value"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/record_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/tile_streak"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="@null" />
    <ImageView
        android:id="@+id/tile_progress"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="@null" />
    <ImageView
        android:id="@+id/tile_record"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:contentDescription="@null" />
</FrameLayout>
