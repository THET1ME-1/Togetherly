<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран выбора холста. Открывается системой при добавлении виджета
  (`android:configure`) и по «Настроить» у поставленного (`reconfigurable`).
  Плитки добавляются кодом: сколько холстов у пары, столько и кнопок.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24dp"
            android:textStyle="bold"
            android:fontFamily="@font/onest_extrabold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:textSize="14dp"
            android:fontFamily="@font/onest_bold"
            android:includeFontPadding="false" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
