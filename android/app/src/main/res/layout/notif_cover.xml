<?xml version="1.0" encoding="utf-8"?>
<!-- Уведомление «А. Обложка», свёрнуто (NotifCover.kt). Шапку с сердечком,
     именем приложения и временем рисует система (DecoratedCustomViewStyle).
     Высота свёрнутого не больше 48dp: три строки без запаса шрифта. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/notif_cover"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/onest_bold"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/notif_title"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/unbounded_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notif_body"
            style="@style/TextAppearance.Compat.Notification.Line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
