<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Вместе», 2×2 — дорожка вех.

  Фон целиком картинка (`WidgetImages.halftone`): скруглённая заливка плюс
  растр точками. У RemoteViews нет способа перекрасить обычный drawable, а тем
  в приложении двадцать, поэтому фон и раньше приходил картинкой — теперь он
  ещё и несёт узор.

  Подписи вех приходят готовыми строками из приложения: склонения и слово
  «через» раньше лежали в Kotlin по-русски, и немец читал русский текст.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/tg_shape_32"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp">

                <ImageView
                    android:id="@+id/avatar_me_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tg_shape_circle"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/avatar_me_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/avatar_me"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text="?" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="21dp">

                <ImageView
                    android:id="@+id/avatar_partner_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/tg_shape_circle"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/avatar_partner_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/avatar_partner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text="?" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/days_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="44dp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="0" />

        <TextView
            android:id="@+id/days_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12dp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/track"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mile_prev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="10dp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <TextView
                android:id="@+id/mile_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textSize="10dp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
