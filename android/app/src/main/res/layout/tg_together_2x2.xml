<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Вместе», 2×2.

  Все заливки — ImageView с нейтральной фигурой, цвет ставит код по активной
  теме приложения: перекрасить обычный background из RemoteViews нельзя.

  Стек из двух аватаров: сверху фотография, под ней кружок с инициалом. Есть
  фото — буква прячется, нет — остаётся кружок (фолбэк из хендофа).

  Содержимое центрировано по вертикали: ячейка 2×2 у Nova почти квадратная, у
  лончера Xiaomi заметно вытянута, и прижатый к краям контент оставлял дыру.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tg_shape_32"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="13dp">

        <!-- Аватары пары -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="26dp">

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp">

                <ImageView
                    android:id="@+id/avatar_me_bg"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/tg_shape_circle"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/avatar_me"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:textSize="11dp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text=" " />

                <ImageView
                    android:id="@+id/avatar_me_photo"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="18dp">

                <ImageView
                    android:id="@+id/avatar_partner_bg"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/tg_shape_circle"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/avatar_partner"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:textSize="11dp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text=" " />

                <ImageView
                    android:id="@+id/avatar_partner_photo"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <TextView
            android:id="@+id/days_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="38dp"
            android:textStyle="bold"
            android:letterSpacing="-0.04"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="—" />

        <TextView
            android:id="@+id/days_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="11dp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="дней вместе" />
    </LinearLayout>
</FrameLayout>
