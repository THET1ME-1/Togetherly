<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <!-- ═══════ Левая половина (Я) ═══════ -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#FFCDD9">

        <ImageView
            android:id="@+id/my_bg_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Полупрозрачный оверлей поверх фото (ImageView вместо View) -->
        <ImageView
            android:id="@+id/my_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99FF6B8A"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal|center_vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/my_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Я"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#CC000000"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/my_mood_emoji"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/my_mood_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="20sp"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/my_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="10sp"
                android:textColor="#CC000000"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/my_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="9sp"
                android:textColor="#99000000"
                android:maxLines="2"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/my_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="8sp"
                android:textColor="#88000000"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />

        </LinearLayout>
    </FrameLayout>

    <!-- ═══════ Разделитель ═══════ -->
    <LinearLayout
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FFFFFFFF">

        <ImageView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#33000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#9829;"
            android:textSize="12sp"
            android:textColor="#FF6B8A"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp" />

        <ImageView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#33000000" />

    </LinearLayout>

    <!-- ═══════ Правая половина (Партнёр) ═══════ -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#E8DAFF">

        <ImageView
            android:id="@+id/partner_bg_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Полупрозрачный оверлей поверх фото (ImageView вместо View) -->
        <ImageView
            android:id="@+id/partner_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99A78BFA"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal|center_vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/partner_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Партнёр"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#CC000000"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/partner_mood_emoji"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/partner_mood_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="20sp"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/partner_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="10sp"
                android:textColor="#CC000000"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/partner_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="9sp"
                android:textColor="#99000000"
                android:maxLines="2"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/partner_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="8sp"
                android:textColor="#88000000"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />

        </LinearLayout>
    </FrameLayout>

</LinearLayout>
