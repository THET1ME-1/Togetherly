<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Кольцо года», 2×2.

  Кольцо во всю карточку, внутри — число дней, подпись и строка до годовщины.
  Кольцо приходит картинкой (`WidgetImages.ring`), текст лежит поверх.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tg_shape_32"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/empty_label"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textSize="12dp"
        android:fontFamily="@font/onest_extrabold"
        android:includeFontPadding="false"
        android:visibility="gone"
        android:text="@string/tg_widget_no_start_date" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="11dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="26dp"
            android:paddingRight="26dp">

            <TextView
                android:id="@+id/ring_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="26dp"
                android:fontFamily="@font/onest_extrabold"
                android:letterSpacing="-0.045"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—" />

            <TextView
                android:id="@+id/ring_days_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9dp"
                android:fontFamily="@font/onest_extrabold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="дней вместе" />

            <TextView
                android:id="@+id/next_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="8dp"
                android:fontFamily="@font/onest_extrabold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text=" " />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
