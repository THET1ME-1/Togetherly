<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Скучаю», 4×1 — полоска.

  Лицо партнёра, счёт одной строкой и круглая кнопка справа. Кнопка круглая,
  а не квадрат в углу: в полоске высотой 74dp только она и читается как
  действие.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tg_shape_28"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp">

            <ImageView
                android:id="@+id/avatar_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/tg_shape_circle"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/avatar_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="13dp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:text="?" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14dp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11.5dp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/send_button"
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/send_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/tg_shape_circle"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/state_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tg_heart"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
