<?xml version="1.0" encoding="utf-8"?>
<!--
  Виджет «Вместе», 4×4.

  Каждая заливка — ImageView с нейтральной фигурой под содержимым: цвет ставит
  код по активной теме приложения, из RemoteViews обычный background не
  перекрасить.

  Высота ячейки 4×4 сильно зависит от лончера: Nova даёт ниже квадрата (строка
  «1 год» схлопывалась в цветную полоску), лончер Xiaomi — заметно выше (внизу
  оставалась треть пустой карточки). Поэтому столбец собран на wrap_content и
  центрирован: сжиматься нечему, лишняя высота уходит в поля.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/tg_shape_36"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/couple_names"
                android:layout_width="1dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="11dp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <ImageView
                android:id="@+id/heart_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_heart_timer"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- Крупный счётчик -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp">

            <ImageView
                android:id="@+id/counter_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/tg_shape_28"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="1dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/days_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="46dp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.045"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="—" />

                    <TextView
                        android:id="@+id/days_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="11dp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:text="дней вместе" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/months_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18dp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:text="0" />

                    <TextView
                        android:id="@+id/months_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="11dp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:text="месяцев" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/next_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:textSize="11dp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:includeFontPadding="false"
            android:text="ДАЛЬШЕ" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/next_round_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/tg_shape_20"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp">

                <TextView
                    android:id="@+id/next_round_title"
                    android:layout_width="1dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11dp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="" />

                <TextView
                    android:id="@+id/next_round_when"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="11dp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text="" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/anniversary_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/tg_shape_20"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp">

                <TextView
                    android:id="@+id/anniversary_title"
                    android:layout_width="1dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11dp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="" />

                <TextView
                    android:id="@+id/anniversary_when"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="11dp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text="" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
