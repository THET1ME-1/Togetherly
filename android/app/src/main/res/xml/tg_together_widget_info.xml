<?xml version="1.0" encoding="utf-8"?>
<!--
  «Вместе» из нового каталога. Ставится как 4×2 (в этом размере виджет
  показывает и счётчик, и прогресс до круглой даты), тянется от 2×2 до 4×4 —
  раскладку под фактический размер выбирает сам провайдер.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/tg_together_4x2"
    android:previewLayout="@layout/tg_together_4x2"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
