<?xml version="1.0" encoding="utf-8"?>
<!--
  Размер 4×1, отдельная позиция в списке виджетов.

  previewImage обязателен наравне с previewLayout: лончеры без поддержки
  previewLayout (в том числе MIUI) иначе не показывают виджет в списке вовсе —
  именно из-за этого новые виджеты не появлялись.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/tg_miss_4x1"
    android:previewLayout="@layout/tg_miss_4x1"
    android:previewImage="@drawable/tg_preview_miss_4x1"
    android:description="@string/tg_desc_miss_4x1"
    android:minWidth="300dp"
    android:minHeight="60dp"
    android:minResizeWidth="240dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
