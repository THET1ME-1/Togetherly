<?xml version="1.0" encoding="utf-8"?>
<!--
  Позиция в списке виджетов лончера.

  minWidth/minHeight считаются как 70*n-30: столько занимает n ячеек на
  стандартной сетке. Просить больше нельзя — лончер всё равно выдаёт ячейку по
  своей сетке и молча сжимает содержимое, обрезая нижние строки.

  previewImage без previewLayout: разметка-превью рисуется с пустыми данными,
  и в диалоге установки виджет выглядит сломанным. Картинку рисует
  tools/gen_widget_previews.py.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/tg_grid_2x2"
    android:previewImage="@drawable/tg_preview_grid_2x2"
    android:description="@string/tg_desc_grid_2x2"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="306dp"
    android:maxResizeHeight="276dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
