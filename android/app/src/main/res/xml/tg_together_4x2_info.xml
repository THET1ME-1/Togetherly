<?xml version="1.0" encoding="utf-8"?>
<!--
  Отдельная позиция в списке виджетов: размер 4×2. Так пользователь
  выбирает форму прямо при добавлении, а не тянет виджет после установки.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/tg_together_4x2"
    android:previewLayout="@layout/tg_together_4x2"
    android:minWidth="300dp"
    android:minHeight="140dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="none"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
