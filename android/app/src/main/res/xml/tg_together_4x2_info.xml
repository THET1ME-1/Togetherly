<?xml version="1.0" encoding="utf-8"?>
<!--
  «Вместе» 4×2 — отдельная позиция в списке виджетов.

  minWidth/minHeight считаются как 70*n-30: столько занимает n ячеек на
  стандартной сетке. Просить больше нельзя — лончер всё равно выдаёт ячейку по
  своей сетке и молча сжимает содержимое, обрезая нижние строки. Так пропала
  полоса прогресса в 4×2 и схлопнулась строка годовщины в 4×4.

  previewImage без previewLayout: разметка-превью рисуется с пустыми данными
  (число «—», нули), и в диалоге установки виджет выглядит сломанным. Картинка
  показывает то же, что и макет; рисует её tools/gen_widget_previews.py.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/tg_together_4x2"
    android:previewImage="@drawable/tg_preview_together_4x2"
    android:description="@string/tg_desc_together_4x2"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="100dp"
    android:maxResizeWidth="624dp"
    android:maxResizeHeight="276dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
