<?xml version="1.0" encoding="utf-8"?>
<!--
  Размер 2×2, отдельная позиция в списке виджетов.

  previewImage обязателен наравне с previewLayout: лончеры без поддержки
  previewLayout (в том числе MIUI) иначе не показывают виджет в списке вовсе —
  именно из-за этого новые виджеты не появлялись.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/tg_miss_2x2"
    android:previewLayout="@layout/tg_miss_2x2"
    android:previewImage="@drawable/tg_preview_miss_2x2"
    android:description="@string/tg_desc_miss_2x2"
    android:minWidth="140dp"
    android:minHeight="140dp"
    android:minResizeWidth="80dp"
    android:minResizeHeight="100dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
