<?xml version="1.0" encoding="utf-8"?>
<!--
  «Маскот на столе» 2x2 — полка.

  minWidth/minHeight по формуле 70*n-30: ровно столько занимает ячейка на
  стандартной сетке. Просить больше нельзя — лончер выдаст своё и молча
  обрежет содержимое.

  previewImage без previewLayout: разметка с пустыми данными выглядит
  сломанной, а лончеры без поддержки previewLayout (MIUI) без картинки не
  показывают виджет вовсе. Картинку рисует tools/gen_widget_previews.py.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/tg_mascot_2x2"
    android:previewImage="@drawable/tg_preview_mascot_2x2"
    android:description="@string/tg_desc_mascot_2x2"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="100dp"
    android:minResizeHeight="100dp"
    android:maxResizeWidth="624dp"
    android:maxResizeHeight="276dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
