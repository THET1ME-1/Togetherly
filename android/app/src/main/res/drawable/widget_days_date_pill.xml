<?xml version="1.0" encoding="utf-8"?>
<!--
  Подложка под дату начала на виджете «Дни вместе».

  Когда пара включает свои фотографии, круглые аватары стоят внизу и на
  невысоком виджете подходят вплотную к дате: тёмно-коричневая строка ложится
  на снимок и пропадает («когда выбираешь показывать свои фото — дату не
  видно», @qwinken, 25.08.2026). Светлая пилюля держит контраст на любом фоне.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F2FFFFFF" />
    <corners android:radius="10dp" />
</shape>
