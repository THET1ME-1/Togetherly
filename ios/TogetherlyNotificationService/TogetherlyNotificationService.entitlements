<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Общая группа с приложением: оттуда расширение берёт пропуск входа и
	     качает закрытое фото воспоминания (CoverMedia.fileToken). Группа
	     привязана к App ID com.togetherly.love.NotificationService 28.11.2026. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.togetherly.love</string>
	</array>
</dict>
</plist>
