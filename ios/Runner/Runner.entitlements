<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple (обязательно для App Store, т.к. есть вход через Google) -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Push-уведомления (firebase_messaging). На релизе = production. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- Общая группа с виджет-расширением (home_widget пишет сюда данные виджетов). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.togetherly.love</string>
	</array>

	<!-- Universal Links — паритет с Android App Links (приглашения по https://).
	     Своё имя первым: AASA лежит на togetherly.day
	     (/.well-known/apple-app-site-association), приглашения выдаются только
	     с ним. duckdns и Firebase-хост оставлены ради ссылок, которые люди уже
	     разослали и которые живут в чужих переписках. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:togetherly.day</string>
		<string>applinks:togetherly.duckdns.org</string>
		<string>applinks:togetherly-d4856.web.app</string>
	</array>

	<!-- Возраст из App Store (Declared Age Range, канал love_app/age_signals):
	     закон Калифорнии AB 1043 с 01.01.2027. Возможность включена у App ID
	     com.togetherly.love 26.11.2026, профили App Store с тех пор её несут.
	     Без неё в App ID подпись сборки падает. -->
	<key>com.apple.developer.declared-age-range</key>
	<true/>

	<!-- Уведомления «А»: события партнёра — уведомлениями о сообщении, с его
	     аватаром в рамке слева (TogetherlyNotificationService, CoverMedia.asMessage).
	     Возможность включена у App ID com.togetherly.love 28.11.2026 в портале;
	     прежние профили App Store стали недействительными, релиз создаёт новые
	     сам (fetch-signing-files берёт только действующие). -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
</dict>
</plist>
