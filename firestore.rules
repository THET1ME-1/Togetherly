rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Пользователи ──
    match /users/{userId} {
      allow read: if request.auth != null;
      // Свой документ — полный доступ
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      // Обновление: себе — всё; другим — только pairId/pairIds (для приглашений)
      allow update: if request.auth != null
                    && (request.auth.uid == userId
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pairId', 'pairIds']));
    }

    // ── Коды приглашений ──
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      // Удалять может владелец или тот, кто принимает приглашение
      allow delete: if request.auth != null;
    }

    // ── Пары (legacy) ──
    match /pairs/{pairId} {
      allow read: if request.auth != null
                  && (resource.data.user1 == request.auth.uid
                      || resource.data.user2 == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && (resource.data.user1 == request.auth.uid
                        || resource.data.user2 == request.auth.uid);
      allow delete: if request.auth != null
                    && (resource.data.user1 == request.auth.uid
                        || resource.data.user2 == request.auth.uid);
    }

    // ── Группы ──
    match /groups/{groupId} {
      // Читать — только участники
      allow read: if request.auth != null 
                  && request.auth.uid in resource.data.members;
      // Создать — любой авторизованный
      allow create: if request.auth != null;
      // Обновить — текущие участники ИЛИ тот, кто присоединяется (его uid будет в новых members)
      allow update: if request.auth != null 
                    && (request.auth.uid in resource.data.members
                        || request.auth.uid in request.resource.data.members);
      // Удалить — только текущие участники
      allow delete: if request.auth != null 
                    && request.auth.uid in resource.data.members;

      // Подколлекции внутри группы
      match /memories/{memoryId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      match /moodCalendar/{userId}/{document=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /widgetData/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /reflections/{date} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow write: if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }

      match /missYouEvents/{eventId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }

      // ── Совместное рисование ──
      // Структура: groups/{groupId}/canvas/main/strokes/{strokeId}
      //            groups/{groupId}/canvas/main/live/{userId}
      //
      // Вспомогательная функция: является ли запрашивающий участником группы
      function isMember() {
        return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }

      // Завершённые штрихи — читают и пишут все участники группы
      match /canvas/main/strokes/{strokeId} {
        allow read:   if isMember();
        allow create: if isMember();
        // Удалять может только автор штриха (undo) ИЛИ любой участник (clear canvas)
        allow delete: if isMember();
        // Обновление не используется
        allow update: if false;
      }

      // Текущий (live) штрих — каждый пишет только свой документ, читают все
      match /canvas/main/live/{authorId} {
        allow read:   if isMember();
        allow create, update: if isMember() && request.auth.uid == authorId;
        allow delete: if isMember() && request.auth.uid == authorId;
      }
    }

    // Всё остальное — запрещено
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
